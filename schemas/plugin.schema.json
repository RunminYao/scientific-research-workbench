{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RunminYao/scientific-research-workbench/schemas/plugin.schema.json",
  "title": "Scientific Research Workbench plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "description", "author", "homepage", "repository", "license", "keywords", "skills", "interface"],
  "properties": {
    "name": {"const": "scientific-research-workbench"},
    "version": {"type": "string", "pattern": "^0\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string", "minLength": 20},
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"type": "string", "minLength": 1}}
    },
    "homepage": {"type": "string", "pattern": "^https://"},
    "repository": {"type": "string", "pattern": "^https://"},
    "license": {"const": "Apache-2.0"},
    "keywords": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "skills": {"type": "string", "pattern": "^\\./[^/].*/$"},
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "shortDescription", "longDescription", "developerName", "category", "capabilities", "defaultPrompt"],
      "properties": {
        "displayName": {"type": "string", "minLength": 1},
        "shortDescription": {"type": "string", "minLength": 1},
        "longDescription": {"type": "string", "minLength": 1},
        "developerName": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "defaultPrompt": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    }
  }
}
