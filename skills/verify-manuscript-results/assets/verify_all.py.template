#!/usr/bin/env python3
"""Run every project-local verify_*.py script except this orchestrator."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


HERE = Path(__file__).resolve().parent


def main() -> int:
    scripts = sorted(
        path
        for path in HERE.glob("verify_*.py")
        if path.name not in {"verify_all.py", "verification_helpers.py"}
    )
    if not scripts:
        print("ERROR: no project-specific verification scripts found", file=sys.stderr)
        return 2
    for script in scripts:
        print(f"\n==> {script.name}", flush=True)
        result = subprocess.run([sys.executable, str(script)], check=False)
        if result.returncode:
            return result.returncode
    print("\nPASS: all manuscript verifications")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
