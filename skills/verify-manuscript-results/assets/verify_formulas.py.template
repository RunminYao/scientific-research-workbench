#!/usr/bin/env python3
"""Pattern for project-specific symbolic manuscript checks."""

from __future__ import annotations

import sympy as sp

from verification_helpers import check_symbolic_zero, print_summary

MANUSCRIPT_CHECKS_CONFIGURED = False


def verify_declared_identity() -> None:
    """Replace this demonstration with an independently constructed paper identity."""
    x = sp.symbols("x")
    expanded = sp.expand((x + 1) ** 2)
    expected = x**2 + 2 * x + 1
    check_symbolic_zero("symbolic harness demonstration", expanded - expected)


def main() -> None:
    if not MANUSCRIPT_CHECKS_CONFIGURED:
        raise SystemExit(
            "No manuscript-specific symbolic checks are configured; "
            "replace the demonstration and set MANUSCRIPT_CHECKS_CONFIGURED = True."
        )
    verify_declared_identity()
    print_summary()


if __name__ == "__main__":
    main()
