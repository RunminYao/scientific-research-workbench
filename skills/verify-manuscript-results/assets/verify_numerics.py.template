#!/usr/bin/env python3
"""Pattern for project-specific numerical manuscript checks."""

from __future__ import annotations

from verification_helpers import check_close, print_summary

MANUSCRIPT_CHECKS_CONFIGURED = False


def verify_declared_value() -> None:
    """Replace this demonstration with a fresh calculation of a quoted value."""
    independently_computed = sum([0.1] * 10)
    check_close(
        "numerical harness demonstration",
        independently_computed,
        1.0,
        abs_tol=1.0e-12,
        rel_tol=1.0e-12,
    )


def main() -> None:
    if not MANUSCRIPT_CHECKS_CONFIGURED:
        raise SystemExit(
            "No manuscript-specific numerical checks are configured; "
            "replace the demonstration and set MANUSCRIPT_CHECKS_CONFIGURED = True."
        )
    verify_declared_value()
    print_summary()


if __name__ == "__main__":
    main()
